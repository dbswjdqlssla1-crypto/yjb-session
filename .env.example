# 네이버 메일 SMTP 설정
# 네이버 메일 > 환경설정 > POP3/IMAP 설정에서 IMAP/SMTP 사용을 켜고,
# 2단계 인증을 쓰는 경우 애플리케이션 비밀번호를 발급받아 SMTP_PASS에 사용하세요.
SMTP_HOST=smtp.naver.com
SMTP_PORT=587
SMTP_USER=dbswjdqlssla@naver.com
SMTP_PASS=your-naver-app-password

# 알림을 받을 담당자 이메일
NOTIFY_EMAIL=dbswjdqlssla@naver.com

# 아래 두 값은 로컬 개발에서는 비워두세요 (자동으로 파일 저장으로 대체됩니다).
# Vercel에 배포한 뒤 Storage 탭에서 Upstash Redis 연동을 추가하면
# Vercel이 이 값을 프로젝트 환경변수에 자동으로 채워줍니다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
